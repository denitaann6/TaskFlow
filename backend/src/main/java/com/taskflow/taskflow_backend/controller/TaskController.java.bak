package com.taskflow.taskflow_backend.controller;

import com.taskflow.taskflow_backend.entity.PoppedTaskHistoryEntry;
import com.taskflow.taskflow_backend.entity.Task;
import com.taskflow.taskflow_backend.entity.User;
import com.taskflow.taskflow_backend.repository.TaskRepository;
import com.taskflow.taskflow_backend.service.AuthService;
import com.taskflow.taskflow_backend.service.TaskBSTService;
import com.taskflow.taskflow_backend.service.TaskGraphService;
import com.taskflow.taskflow_backend.service.TaskLinkedListService;
import com.taskflow.taskflow_backend.service.TaskQueueService;
import com.taskflow.taskflow_backend.service.TaskSearchSortService;
import com.taskflow.taskflow_backend.service.TaskStackService;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.server.ResponseStatusException;

import java.util.*;

@RestController
@RequestMapping("/api/tasks")
@CrossOrigin(origins = "*", methods = {RequestMethod.GET, RequestMethod.POST, RequestMethod.DELETE, RequestMethod.PUT, RequestMethod.OPTIONS})
public class TaskController {

    private final TaskRepository taskRepository;
    private final TaskLinkedListService linkedListService;
    private final TaskQueueService queueService;
    private final TaskStackService stackService;
    private final TaskBSTService bstService;
    private final TaskGraphService graphService;
    private final TaskSearchSortService searchSortService;
    private final AuthService authService;

    public TaskController(
            TaskRepository taskRepository,
            TaskLinkedListService linkedListService,
            TaskQueueService queueService,
            TaskStackService stackService,
            TaskBSTService bstService,
            TaskGraphService graphService,
            TaskSearchSortService searchSortService,
            AuthService authService) {
        this.taskRepository = taskRepository;
        this.linkedListService = linkedListService;
        this.queueService = queueService;
        this.stackService = stackService;
        this.bstService = bstService;
        this.graphService = graphService;
        this.searchSortService = searchSortService;
        this.authService = authService;
    }

    /**
     * Get tasks.
     * Administrators see all tasks in the system.
     * Members see ONLY tasks assigned to their account (enforced at backend).
     */
    @GetMapping
    public List<Task> getAllTasks(
            @RequestParam(required = false) String search,
            HttpServletRequest httpRequest) {
        User user = authService.requireUser(httpRequest);

        List<Task> tasks = taskRepository.findAll();

        // Enforce member isolation: Members only receive their assigned tasks
        if (!"ADMIN".equalsIgnoreCase(user.getRole())) {
            tasks = tasks.stream()
                    .filter(t -> matchesMember(t, user))
                    .toList();
        }

        if (search != null && !search.trim().isEmpty()) {
            String query = search.trim().toLowerCase();
            tasks = tasks.stream().filter(task -> {
                boolean idMatches = task.getId() != null && String.valueOf(task.getId()).contains(query);
                boolean nameMatches = task.getName() != null && task.getName().toLowerCase().contains(query);
                boolean memberMatches = task.getMember() != null && task.getMember().toLowerCase().contains(query);
                return idMatches || nameMatches || memberMatches;
            }).toList();
        }

        return linkedListService.arrangeTasksAsLinkedList(tasks);
    }

    /**
     * Get single task by ID.
     * Members cannot view tasks assigned to other members (IDOR protection).
     */
    @GetMapping("/{id}")
    public Task getTaskById(@PathVariable Integer id, HttpServletRequest httpRequest) {
        User user = authService.requireUser(httpRequest);
        Task task = taskRepository.findById(id).orElseThrow(() ->
                new ResponseStatusException(HttpStatus.NOT_FOUND, "Task not found with ID: " + id));

        if (!"ADMIN".equalsIgnoreCase(user.getRole()) && !matchesMember(task, user)) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN,
                    "Access denied: You cannot view tasks assigned to other team members.");
        }
        return task;
    }

    /**
     * Create a task.
     * Administrator only.
     */
    @PostMapping
    public Task addTask(
            @RequestParam Integer id,
            @RequestParam String name,
            @RequestParam String member,
            @RequestParam(defaultValue = "Medium") String priority,
            @RequestParam(defaultValue = "Pending") String status,
            HttpServletRequest httpRequest) {

        authService.requireAdmin(httpRequest);

        if (id == null || id <= 0) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid Task ID");
        }
        if (name == null || name.trim().isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Task name cannot be empty");
        }
        if (member == null || member.trim().isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Assignee member cannot be empty");
        }

        if (taskRepository.existsById(id)) {
            throw new ResponseStatusException(HttpStatus.CONFLICT, "Task ID " + id + " already exists");
        }

        Task task = new Task();
        task.setId(id);
        task.setName(name.trim());
        task.setMember(member.trim());
        task.setPriority(normalizePriority(priority));
        task.setStatus(normalizeStatus(status));

        Task saved = taskRepository.save(task);
        linkedListService.insertTail(saved);
        if ("Completed".equalsIgnoreCase(saved.getStatus())) {
            stackService.push(saved);
        } else if ("Pending".equalsIgnoreCase(saved.getStatus())) {
            queueService.enqueue(saved);
        }
        return saved;
    }

    /**
     * Edit task details.
     * Administrator only.
     */
    @PutMapping("/{id}")
    public Task editTask(
            @PathVariable Integer id,
            @RequestParam(required = false) String name,
            @RequestParam(required = false) String member,
            @RequestParam(required = false) String priority,
            @RequestParam(required = false) String status,
            HttpServletRequest httpRequest) {

        authService.requireAdmin(httpRequest);

        Task task = taskRepository.findById(id).orElseThrow(() ->
                new ResponseStatusException(HttpStatus.NOT_FOUND, "Task not found with ID: " + id));

        if (name != null && !name.trim().isEmpty()) {
            task.setName(name.trim());
        }
        if (member != null && !member.trim().isEmpty()) {
            task.setMember(member.trim());
        }
        if (priority != null && !priority.trim().isEmpty()) {
            task.setPriority(normalizePriority(priority));
        }
        if (status != null && !status.trim().isEmpty()) {
            task.setStatus(normalizeStatus(status));
        }

        Task updated = taskRepository.save(task);
        linkedListService.loadFromTasks(taskRepository.findAll());
        if ("Completed".equalsIgnoreCase(updated.getStatus())) {
            queueService.removeById(id);
            stackService.push(updated);
        } else if ("In Progress".equalsIgnoreCase(updated.getStatus())) {
            queueService.removeById(id);
            stackService.removeById(id);
        } else {
            stackService.removeById(id);
            queueService.enqueue(updated);
        }
        return updated;
    }

    /**
     * Delete a task.
     * Administrator only.
     */
    @DeleteMapping("/{id}")
    public String deleteTask(@PathVariable Integer id, HttpServletRequest httpRequest) {
        authService.requireAdmin(httpRequest);

        if (!taskRepository.existsById(id)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Task not found with ID: " + id);
        }

        taskRepository.deleteById(id);
        linkedListService.deleteById(id);
        queueService.removeById(id);
        stackService.removeById(id);
        graphService.removeTask(id);
        return "Task deleted successfully";
    }

    /**
     * Update task status (Pending, In Progress, or Completed).
     * Administrators can change any task status.
     * Members can ONLY change their own task status (IDOR protection enforced).
     */
    @PutMapping("/{id}/status")
    public Task updateTaskStatus(
            @PathVariable Integer id,
            @RequestParam String status,
            HttpServletRequest httpRequest) {

        User user = authService.requireUser(httpRequest);

        Task task = taskRepository.findById(id).orElseThrow(() ->
                new ResponseStatusException(HttpStatus.NOT_FOUND, "Task not found with ID: " + id));

        // Enforce IDOR protection: Members cannot update other members' tasks
        if (!"ADMIN".equalsIgnoreCase(user.getRole())) {
            if (!matchesMember(task, user)) {
                throw new ResponseStatusException(HttpStatus.FORBIDDEN,
                        "Access denied: You can only update status for tasks assigned to your account.");
            }
        }

        String oldStatus = task.getStatus();
        String normStatus = normalizeStatus(status);

        // Idempotency: If status has not changed, do not trigger redundant queue/stack mutations
        if (normStatus.equalsIgnoreCase(oldStatus)) {
            return task;
        }

        task.setStatus(normStatus);
        Task updated = taskRepository.save(task);

        if ("Completed".equalsIgnoreCase(normStatus)) {
            queueService.removeById(id);
            stackService.push(updated);
        } else if ("In Progress".equalsIgnoreCase(normStatus)) {
            queueService.removeById(id);
            stackService.removeById(id);
        } else {
            stackService.removeById(id);
            queueService.enqueue(updated);
        }
        return updated;
    }

    /**
     * Mark a task as completed.
     * Members can only complete their own tasks (IDOR protected).
     */
    @PostMapping("/{id}/complete")
    public Task completeTask(@PathVariable Integer id, HttpServletRequest httpRequest) {
        User user = authService.requireUser(httpRequest);

        Task task = taskRepository.findById(id).orElseThrow(() ->
                new ResponseStatusException(HttpStatus.NOT_FOUND, "Task not found with ID: " + id));

        if (!"ADMIN".equalsIgnoreCase(user.getRole()) && !matchesMember(task, user)) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN,
                    "Access denied: You can only complete tasks assigned to your account.");
        }

        // Idempotency: If already completed, do not re-push an already-popped task
        if ("Completed".equalsIgnoreCase(task.getStatus())) {
            return task;
        }

        task.setStatus("Completed");
        Task updated = taskRepository.save(task);
        queueService.removeById(id);
        stackService.push(updated);
        return updated;
    }

    /**
     * Comprehensive Dashboard Statistics.
     * Administrator: Total organization tasks, team workload, status counts, completion %.
     * Member: Personalized statistics for only their assigned tasks.
     */
    @GetMapping("/stats/summary")
    public Map<String, Object> getStatsSummary(HttpServletRequest httpRequest) {
        User user = authService.requireUser(httpRequest);
        List<Task> allTasks = taskRepository.findAll();

        if (!"ADMIN".equalsIgnoreCase(user.getRole())) {
            // Member statistics
            List<Task> memberTasks = allTasks.stream()
                    .filter(t -> matchesMember(t, user))
                    .toList();

            long total = memberTasks.size();
            long pending = memberTasks.stream().filter(t -> "Pending".equalsIgnoreCase(t.getStatus())).count();
            long inProgress = memberTasks.stream().filter(t -> "In Progress".equalsIgnoreCase(t.getStatus())).count();
            long completed = memberTasks.stream().filter(t -> "Completed".equalsIgnoreCase(t.getStatus())).count();
            double completionRate = total > 0 ? ((double) completed / total) * 100.0 : 0.0;

            return Map.of(
                    "role", "MEMBER",
                    "user", authService.toDTO(user),
                    "totalTasks", total,
                    "pendingCount", pending,
                    "inProgressCount", inProgress,
                    "completedCount", completed,
                    "completionRate", Math.round(completionRate * 10.0) / 10.0
            );
        } else {
            // Administrator organization-wide statistics
            long total = allTasks.size();
            long pending = allTasks.stream().filter(t -> "Pending".equalsIgnoreCase(t.getStatus())).count();
            long inProgress = allTasks.stream().filter(t -> "In Progress".equalsIgnoreCase(t.getStatus())).count();
            long completed = allTasks.stream().filter(t -> "Completed".equalsIgnoreCase(t.getStatus())).count();
            double completionRate = total > 0 ? ((double) completed / total) * 100.0 : 0.0;

            // Workload distribution by member
            Map<String, Map<String, Object>> memberWorkload = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
            for (Task t : allTasks) {
                String member = t.getMember() != null ? t.getMember() : "Unassigned";
                memberWorkload.putIfAbsent(member, new HashMap<>(Map.of(
                        "total", 0, "pending", 0, "inProgress", 0, "completed", 0
                )));
                Map<String, Object> stats = memberWorkload.get(member);
                stats.put("total", (int) stats.get("total") + 1);
                String st = t.getStatus() != null ? t.getStatus().toLowerCase() : "";
                if (st.contains("pend")) stats.put("pending", (int) stats.get("pending") + 1);
                else if (st.contains("prog")) stats.put("inProgress", (int) stats.get("inProgress") + 1);
                else if (st.contains("comp")) stats.put("completed", (int) stats.get("completed") + 1);
            }

            return Map.of(
                    "role", "ADMIN",
                    "user", authService.toDTO(user),
                    "totalTasks", total,
                    "pendingCount", pending,
                    "inProgressCount", inProgress,
                    "completedCount", completed,
                    "completionRate", Math.round(completionRate * 10.0) / 10.0,
                    "memberWorkload", memberWorkload
            );
        }
    }

    // ==========================================
    // PHASE 1: DATA STRUCTURES ENDPOINTS
    // ==========================================

    // --- 1. Custom Singly Linked List (Nodes & References) ---

    @GetMapping("/linkedlist/traverse")
    public Map<String, Object> traverseLinkedList(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        if (linkedListService.isEmpty()) {
            linkedListService.loadFromTasks(taskRepository.findAll());
        }
        List<Task> tasks = linkedListService.traverse();
        return Map.of(
                "totalNodes", tasks.size(),
                "tasks", tasks,
                "visual", linkedListService.getTraversalVisual(),
                "trace", linkedListService.getTraversalTrace()
        );
    }

    @PostMapping("/linkedlist/insert")
    public Map<String, Object> insertLinkedListNode(
            @RequestParam(defaultValue = "tail") String position,
            @RequestParam Integer id,
            @RequestParam String name,
            @RequestParam String member,
            @RequestParam(defaultValue = "Medium") String priority,
            @RequestParam(defaultValue = "Pending") String status,
            HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        if (id == null || id <= 0) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid Task ID");
        }
        if (name == null || name.trim().isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Task name cannot be empty");
        }

        Task demoTask = new Task();
        demoTask.setId(id);
        demoTask.setName(name.trim());
        demoTask.setMember(member != null ? member.trim() : "Demo User");
        demoTask.setPriority(normalizePriority(priority));
        demoTask.setStatus(normalizeStatus(status));

        if ("head".equalsIgnoreCase(position)) {
            linkedListService.insertHead(demoTask);
        } else {
            linkedListService.insertTail(demoTask);
        }

        return Map.of(
                "success", true,
                "message", "Node inserted successfully at " + position.toLowerCase(),
                "totalNodes", linkedListService.size(),
                "visual", linkedListService.getTraversalVisual()
        );
    }

    @DeleteMapping("/linkedlist/delete")
    public Map<String, Object> deleteLinkedListNode(
            @RequestParam Integer id,
            HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        Task deleted = linkedListService.deleteById(id);
        if (deleted == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Task ID #" + id + " not found in the Linked List");
        }
        return Map.of(
                "success", true,
                "message", "Node for Task #" + id + " unlinked and deleted from Linked List",
                "deletedTask", deleted,
                "remainingNodes", linkedListService.size(),
                "visual", linkedListService.getTraversalVisual()
        );
    }

    @PostMapping("/linkedlist/reset")
    public Map<String, Object> resetLinkedList(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        linkedListService.loadFromTasks(taskRepository.findAll());
        return Map.of(
                "success", true,
                "message", "Linked List reloaded with all " + linkedListService.size() + " tasks from database",
                "totalNodes", linkedListService.size(),
                "visual", linkedListService.getTraversalVisual()
        );
    }

    // --- 2. Custom FIFO Queue (Pending Tasks) ---

    @GetMapping("/queue")
    public List<Task> getPendingQueue(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return queueService.getPendingQueue(taskRepository.findAll());
    }

    @GetMapping("/queue/peek")
    public Map<String, Object> peekQueue(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        if (queueService.isEmpty()) {
            queueService.synchronizePendingTasks(taskRepository.findAll());
        }
        Task frontTask = queueService.peek();
        if (frontTask == null) {
            return Map.of(
                    "empty", true,
                    "message", "Queue is empty. No pending tasks waiting.",
                    "visual", queueService.getQueueVisual()
            );
        }
        return Map.of(
                "empty", false,
                "task", frontTask,
                "message", "Front task is #" + frontTask.getId() + " (\"" + frontTask.getName() + "\")",
                "visual", queueService.getQueueVisual()
        );
    }

    @PostMapping("/queue/enqueue")
    public Map<String, Object> enqueueDemoTask(
            @RequestParam Integer id,
            @RequestParam String name,
            @RequestParam(defaultValue = "Unassigned") String member,
            @RequestParam(defaultValue = "Medium") String priority,
            HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        Task demoTask = new Task();
        demoTask.setId(id);
        demoTask.setName(name);
        demoTask.setMember(member);
        demoTask.setPriority(normalizePriority(priority));
        demoTask.setStatus("Pending");

        queueService.enqueue(demoTask);
        return Map.of(
                "success", true,
                "message", "Enqueued Task #" + id + " at rear of FIFO queue",
                "queueSize", queueService.size(),
                "visual", queueService.getQueueVisual()
        );
    }

    @PostMapping("/queue/sync")
    public Map<String, Object> syncQueue(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        queueService.synchronizePendingTasks(taskRepository.findAll());
        return Map.of(
                "success", true,
                "message", "Queue synchronized with MySQL database",
                "queueDepth", queueService.size(),
                "visual", queueService.getQueueVisual()
        );
    }

    @PostMapping("/process-next")
    public Task processNextPendingTask(HttpServletRequest httpRequest) {
        authService.requireAdmin(httpRequest);
        Task task = queueService.processNextPendingTask(taskRepository.findAll());
        if (task == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "No pending tasks in the queue");
        }
        task.setStatus("In Progress");
        return taskRepository.save(task);
    }

    // --- 3. Custom LIFO Stack (Completed Tasks) ---

    @GetMapping("/stack")
    public List<Task> getCompletedStack(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return stackService.getCompletedStack(taskRepository.findAll());
    }

    @GetMapping("/stack/peek")
    public Map<String, Object> peekStack(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        if (!stackService.isInitialized()) {
            stackService.getCompletedStack(taskRepository.findAll());
        }
        Task topTask = stackService.peek();
        if (topTask == null) {
            return Map.of(
                    "empty", true,
                    "message", "Stack is empty. No completed tasks on top.",
                    "visual", stackService.getStackVisual()
            );
        }
        return Map.of(
                "empty", false,
                "task", topTask,
                "message", "Top of stack is Task #" + topTask.getId() + " (\"" + topTask.getName() + "\")",
                "visual", stackService.getStackVisual()
        );
    }

    @PostMapping("/stack/push")
    public Map<String, Object> pushDemoTask(
            @RequestParam Integer id,
            @RequestParam String name,
            @RequestParam(defaultValue = "Completed") String status,
            HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        Task demoTask = new Task();
        demoTask.setId(id);
        demoTask.setName(name);
        demoTask.setMember("Demo Member");
        demoTask.setPriority("Medium");
        demoTask.setStatus(normalizeStatus(status));

        stackService.push(demoTask);
        return Map.of(
                "success", true,
                "message", "Pushed Task #" + id + " to top of LIFO stack",
                "stackDepth", stackService.size(),
                "visual", stackService.getStackVisual()
        );
    }

    @PostMapping("/stack/pop")
    public Task popCompletedTask(HttpServletRequest httpRequest) {
        User user = authService.requireAdmin(httpRequest);
        if (!stackService.isInitialized()) {
            stackService.initFromDatabase();
        }
        String actor = user.getDisplayName() != null ? user.getDisplayName() : user.getUsername();
        Task popped = stackService.pop(actor);
        if (popped == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Active completed task stack is empty.");
        }
        return popped;
    }

    @PostMapping("/stack/sync")
    public Map<String, Object> syncStack(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        List<Task> activeStack = stackService.getCompletedStack(taskRepository.findAll());
        return Map.of(
                "success", true,
                "message", "Stack synchronized with completed MySQL tasks",
                "stackDepth", activeStack.size(),
                "visual", stackService.getStackVisual()
        );
    }

    @GetMapping("/stack/history")
    public List<PoppedTaskHistoryEntry> getPoppedTasksHistory(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return stackService.getPoppedHistory();
    }

    // --- 4. Custom Linked-List Expression Bracket Validator ---

    @RequestMapping(value = "/brackets/check", method = {RequestMethod.GET, RequestMethod.POST})
    public Map<String, Object> checkBrackets(
            @RequestParam(defaultValue = "") String expression,
            HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return stackService.validateWithTrace(expression);
    }

    @GetMapping("/bst/search")
    public Map<String, Object> searchTaskInBST(@RequestParam Integer id, HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return bstService.searchWithTrace(taskRepository.findAll(), id);
    }

    @GetMapping("/bst/inorder")
    public List<Task> getBSTInorderTraversal(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return bstService.getInorderTraversal(taskRepository.findAll());
    }

    @GetMapping("/bst/preorder")
    public List<Task> getBSTPreorderTraversal(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return bstService.getPreorderTraversal(taskRepository.findAll());
    }

    @GetMapping("/bst/postorder")
    public List<Task> getBSTPostorderTraversal(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return bstService.getPostorderTraversal(taskRepository.findAll());
    }

    // ==========================================
    // PHASE 3: SEARCHING & SORTING ENDPOINTS
    // ==========================================

    @GetMapping("/search/linear")
    public Map<String, Object> linearSearch(@RequestParam String query, HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return searchSortService.linearSearch(taskRepository.findAll(), query);
    }

    @GetMapping("/search/binary")
    public Map<String, Object> binarySearch(@RequestParam Integer id, HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return searchSortService.binarySearch(taskRepository.findAll(), id);
    }

    @GetMapping("/sort/insertion")
    public Map<String, Object> insertionSort(@RequestParam(defaultValue = "id") String sortBy, HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return searchSortService.insertionSort(taskRepository.findAll(), sortBy);
    }

    @PostMapping("/graph/dependency")
    public Map<String, Object> addDependency(
            @RequestParam Integer fromId,
            @RequestParam Integer toId,
            HttpServletRequest httpRequest) {
        authService.requireAdmin(httpRequest);

        boolean fromExists = taskRepository.existsById(fromId);
        boolean toExists = taskRepository.existsById(toId);

        if (!fromExists && !toExists) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Neither Task ID " + fromId + " nor Task ID " + toId + " exists in the database");
        }
        if (!fromExists) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Prerequisite Task ID " + fromId + " does not exist in the database");
        }
        if (!toExists) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Dependent Task ID " + toId + " does not exist in the database");
        }
        if (fromId.equals(toId)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "A task cannot depend on itself (self-dependency is not allowed)");
        }

        boolean added = graphService.addDependency(fromId, toId);
        if (!added) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Dependency edge already exists: Task " + fromId + " -> Task " + toId);
        }
        return Map.of(
                "success", true,
                "message", "Dependency added: Task " + fromId + " must precede Task " + toId
        );
    }

    @GetMapping("/graph")
    public Map<Integer, List<Integer>> getGraph(HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        return graphService.getGraph();
    }

    @GetMapping("/graph/bfs")
    public Map<String, Object> bfsTraversal(@RequestParam Integer startId, HttpServletRequest httpRequest) {
        authService.requireUser(httpRequest);
        if (!taskRepository.existsById(startId)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Start Task ID does not exist in the database");
        }
        List<Integer> order = graphService.bfsTraversal(startId);
        return Map.of(
                "startId", startId,
                "bfsOrder", order,
                "count", order.size()
        );
    }

    @PostMapping("/graph/clear")
    public Map<String, String> clearGraph(HttpServletRequest httpRequest) {
        authService.requireAdmin(httpRequest);
        graphService.clear();
        return Map.of("message", "Task dependencies cleared");
    }

    // Helper to verify task ownership
    private boolean matchesMember(Task task, User user) {
        if (task == null || task.getMember() == null || user == null) return false;
        String taskMember = task.getMember().trim();
        if (taskMember.equalsIgnoreCase(user.getUsername())) return true;
        if (taskMember.equalsIgnoreCase(user.getDisplayName())) return true;
        return user.getAssignedMemberName() != null && taskMember.equalsIgnoreCase(user.getAssignedMemberName().trim());
    }

    private String normalizeStatus(String status) {
        if (status == null || status.trim().isEmpty()) return "Pending";
        String s = status.trim().toLowerCase();
        if (s.contains("comp")) return "Completed";
        if (s.contains("prog")) return "In Progress";
        return "Pending";
    }

    private String normalizePriority(String priority) {
        if (priority == null || priority.trim().isEmpty()) return "Medium";
        String p = priority.trim().toLowerCase();
        if (p.startsWith("h")) return "High";
        if (p.startsWith("l")) return "Low";
        return "Medium";
    }

    @ExceptionHandler(ResponseStatusException.class)
    public ResponseEntity<Map<String, Object>> handleResponseStatusException(ResponseStatusException ex) {
        String msg = ex.getReason() != null ? ex.getReason() : (ex.getMessage() != null ? ex.getMessage() : "Error occurred");
        return ResponseEntity.status(ex.getStatusCode()).body(Map.of(
                "status", ex.getStatusCode().value(),
                "message", msg,
                "error", msg
        ));
    }
}
