<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team Directory — TaskFlow</title>
  <meta name="description" content="Team directory and workload roster for TaskFlow project members.">
  <link rel="stylesheet" href="css/style.css">
  <link rel="icon" type="image/svg+xml" href="assets/logo.svg">
</head>
<body>

  <div class="app-container">
    <div id="sidebar-container"></div>

    <div class="app-main">
      <div id="header-container"></div>

      <main class="page-body">

        <!-- Banner -->
        <div class="card" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2f6 100%); border-color: #cbd5e1; margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div>
              <span class="welcome-pill" style="background: #e0e7ff; color: #3730a3;">Organization Roster</span>
              <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--navy-900); margin-top: 6px;">Team Collaboration Directory</h2>
              <p style="font-size: 0.88rem; color: var(--slate-600); max-width: 600px; margin-top: 4px;">
                Predefined role-based member accounts mapped to existing tasks in the MySQL database.
              </p>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 0.8rem; color: var(--slate-500); display: block;">Total Team Members</span>
              <strong id="total-team-count" style="font-size: 1.6rem; color: var(--navy-900);">-</strong>
            </div>
          </div>
        </div>

        <!-- Team Members Grid -->
        <div id="team-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
          <!-- Dynamically populated -->
        </div>

      </main>
    </div>
  </div>

  <script src="js/api.js"></script>
  <script src="js/navbar.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const user = API.requireAuth();
      if (!user) return;

      renderAppLayout('team', 'Team Collaboration Directory');

      try {
        const [teamMembers, allTasks] = await Promise.all([
          API.getTeamMembers(),
          API.getTasks()
        ]);

        document.getElementById('total-team-count').textContent = teamMembers.length;

        // Map task count per member
        const taskCounts = {};
        allTasks.forEach(t => {
          const m = (t.member || '').toLowerCase();
          taskCounts[m] = (taskCounts[m] || 0) + 1;
        });

        const grid = document.getElementById('team-grid');
        grid.innerHTML = teamMembers.map(m => {
          const nameLower = (m.assignedMemberName || m.displayName || m.username).toLowerCase();
          const count = taskCounts[nameLower] || taskCounts[m.username.toLowerCase()] || 0;
          const initials = (m.displayName || m.username).substring(0, 2).toUpperCase();

          return `
            <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                  <div class="user-avatar-circle" style="width: 44px; height: 44px; font-size: 1rem;">${initials}</div>
                  <span class="role-badge member">${escapeHtml(m.role)}</span>
                </div>
                <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--navy-900);">${escapeHtml(m.displayName || m.username)}</h4>
                <div style="font-size: 0.8rem; color: var(--slate-500); font-family: var(--font-mono); margin-top: 2px;">@${escapeHtml(m.username)}</div>
                
                <div style="margin-top: 16px; padding: 12px; background: var(--slate-50); border-radius: 8px; border: 1px solid var(--slate-200);">
                  <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--slate-600); margin-bottom: 4px;">
                    <span>Assigned Tasks</span>
                    <strong style="color: var(--navy-900);">${count}</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--slate-600);">
                    <span>Account Status</span>
                    <span style="color: #059669; font-weight: 600;">● Active</span>
                  </div>
                </div>
              </div>

              <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--slate-200); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.75rem; color: var(--slate-400);">Mapped in MySQL</span>
                <a href="tasks.html" class="btn btn-secondary btn-sm" style="padding: 4px 10px; font-size: 0.75rem;">View Tasks</a>
              </div>
            </div>
          `;
        }).join('');

      } catch (err) {
        API.showToast('Failed to load team directory: ' + err.message, 'error');
      }
    });

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
  </script>
</body>
</html>
